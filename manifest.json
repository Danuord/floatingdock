{
  "manifest_version": 3,
  "name": "InventarySide",
  "version": "0.1.0",
  "description": "Dock lateral para gestionar aplicaciones web en ventanas flotantes.",
  "permissions": ["storage", "tabs", "windows", "sidePanel"],
  "host_permissions": [
  "https://script.google.com/*",
  "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_title": "Abrir Floating Dock"
  },
  "side_panel": {
    "default_path": "dock/dock.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
  "extension_pages": "script-src 'self'; object-src 'self'"
  }
}